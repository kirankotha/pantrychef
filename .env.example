# ─────────────────────────────────────────────
# PantryChef — Environment Variables
# Copy to .env.local (frontend) and .env (backend)
# ─────────────────────────────────────────────

# ── REQUIRED ──────────────────────────────────
# OpenAI API Key (get at platform.openai.com)
OPENAI_API_KEY=sk-proj-...

# ── DATABASE ──────────────────────────────────
DATABASE_URL=postgresql+asyncpg://pantrychef:password@localhost:5432/pantrychef
DB_PASSWORD=changeme_in_production

# ── AUTHENTICATION ────────────────────────────
SECRET_KEY=generate-a-long-random-string-here-min-32-chars
NEXTAUTH_SECRET=another-long-random-string
NEXTAUTH_URL=http://localhost:3000

# ── FRONTEND (Next.js) ────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── REDIS (optional caching) ──────────────────
REDIS_URL=redis://localhost:6379

# ── OPTIONAL: Nutrition APIs ──────────────────
# Spoonacular (for enhanced nutrition data)
SPOONACULAR_API_KEY=
# Edamam (alternative nutrition API)
EDAMAM_APP_ID=
EDAMAM_APP_KEY=

# ── DEPLOYMENT ────────────────────────────────
ENVIRONMENT=development
# production | development
